<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lifeos</groupId>
        <artifactId>lifeos-root-pom</artifactId>
        <version>0.1.0</version>
        <relativePath/>
    </parent>

    <artifactId>lifeos-trigger-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>lifeos-trigger-service</name>
    <description>Trigger: scheduling and drift detection</description>

    <properties>
        <lifeos-base.version>0.2.0</lifeos-base.version>
        <lifeos-contracts.version>0.1.0</lifeos-contracts.version>
    </properties>

    <!-- Used to resolve the parent POM, lifeos-base and lifeos-contracts when they are not in the local ~/.m2 (e.g. in CI).
         Credentials come from the server with id "github" in settings.xml. -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/lifeos-io/*</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- JWT resource server, @CurrentUser, problem responses, correlation filter -->
        <dependency>
            <groupId>com.lifeos</groupId>
            <artifactId>lifeos-base-web</artifactId>
            <version>${lifeos-base.version}</version>
        </dependency>
        <!-- Outbox, relay and inbox (creates its own tables) -->
        <dependency>
            <groupId>com.lifeos</groupId>
            <artifactId>lifeos-base-messaging</artifactId>
            <version>${lifeos-base.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lifeos</groupId>
            <artifactId>lifeos-contracts</artifactId>
            <version>${lifeos-contracts.version}</version>
        </dependency>
        <!-- Add ShedLock (shedlock table) before scaling the service to 2 replicas -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
